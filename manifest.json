{
  "schemaVersion": 1,
  "id": "ewe.passwords",
  "name": "Passwords",
  "version": "1.3.1",
  "apiVersion": 2,
  "description": "Fill a login from your password manager (ewe Safe, 1Password, Bitwarden, pass) into any window — Super+P.",
  "icon": "icLock",
  "category": "Security",
  "homepage": "https://github.com/prj786/ewe-plugin-passwords",
  "author": "prj786",
  "kinds": [
    "panel"
  ],
  "entryPoints": {
    "panel": "Panel.qml"
  },
  "keybinds": [
    {
      "combo": "SUPER + P",
      "ipc": "ewe.passwords toggle"
    }
  ],
  "settings": [
    {
      "key": "provider",
      "type": "choice",
      "default": "auto",
      "label": "Password manager",
      "description": "ewe is ewe Safe. auto picks ewe Safe once a safe is set up.",
      "choices": [
        "auto",
        "ewe",
        "1password",
        "bitwarden",
        "pass"
      ]
    },
    {
      "key": "press_enter",
      "type": "bool",
      "default": false,
      "label": "Press Enter after the password"
    }
  ]
}
